{%- assign col = collections[section.settings.collection] -%}
{%- if col == blank -%}
  {%- assign col = collections['all'] -%}
{%- endif -%}

<section class="section" style="padding: 12px 0 52px;">
  <div class="container">
    <div class="section-header" style="margin-bottom: 24px;">
      <div>
        <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:8px;">
          <span class="eyebrow" style="margin-bottom:0;">{{ section.settings.eyebrow }}</span>
          {%- if section.settings.show_timer -%}
            <span class="deal-timer-pill" id="deal-countdown">Ends in 04:18:22</span>
          {%- endif -%}
        </div>
        <h2 class="section-title" style="font-size: 30px;">{{ section.settings.heading }}</h2>
      </div>
      <a class="btn btn-secondary" style="padding:9px 18px; font-size:13px;" href="{{ col.url | default: routes.all_products_collection_url }}">
        {{ section.settings.view_all_label }}
      </a>
    </div>

    <div class="cross-sell-grid">
      {%- for product in col.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Deals Grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited-Time Markdowns" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Today's Top Deals" },
    { "type": "checkbox", "id": "show_timer", "label": "Show live countdown pill", "default": true },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 4 },
    { "type": "text", "id": "view_all_label", "label": "View All Button", "default": "See All Deals →" }
  ],
  "presets": [{ "name": "Featured Deals Grid" }]
}
{% endschema %}
