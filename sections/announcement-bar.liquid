{%- if section.settings.show_bar -%}
  <div class="announcement-bar">
    {{ section.settings.text_1 }}
    {%- if section.settings.text_2 != blank -%}
      <span>·</span>{{ section.settings.text_2 }}
    {%- endif -%}
    {%- if section.settings.text_3 != blank -%}
      <span>·</span>{{ section.settings.text_3 }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    { "type": "checkbox", "id": "show_bar", "label": "Show announcement bar", "default": true },
    { "type": "text", "id": "text_1", "label": "Message 1", "default": "Free 2-Day Express Shipping on orders over $75" },
    { "type": "text", "id": "text_2", "label": "Message 2", "default": "60-Day Hassle-Free Returns" },
    { "type": "text", "id": "text_3", "label": "Message 3", "default": "Verified Quality & 24/7 US Support" }
  ]
}
{% endschema %}
