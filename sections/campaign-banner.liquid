{%- assign col = collections[section.settings.collection] -%}
{%- if col == blank -%}
  {%- assign col = collections['all'] -%}
{%- endif -%}

<section style="padding: 4px 0 44px;">
  <div class="container">
    <div class="campaign-banner">
      <div>
        <span class="mp-hero-kicker" style="margin-bottom:10px;">{{ section.settings.kicker }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.subtext }}</p>
        <a class="btn" style="background:#FFFFFF; color:#0B2545;" href="{{ col.url | default: routes.all_products_collection_url }}">
          {{ section.settings.cta_label }}
        </a>
      </div>

      <div class="campaign-kit-grid">
        {%- for product in col.products limit: 3 -%}
          <a class="campaign-kit-tile" href="{{ product.url }}">
            {%- if product.featured_image != blank -%}
              <img src="{{ product.featured_image | image_url: width: 320 }}" alt="{{ product.title | escape }}" />
            {%- endif -%}
            <span>{{ product.title | truncate: 24 }}</span>
            <strong>{{ product.price | money }}</strong>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Campaign Kit Banner",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Badge", "default": "Seasonal Feature · Bundle & Save Extra 18%" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build Your Complete Outdoor & Tactical Kit." },
    { "type": "textarea", "id": "subtext", "label": "Description", "default": "Pair our 600D MOLLE utility gear with weatherproof outerwear, gloves, and HD optics—engineered for field durability." },
    { "type": "text", "id": "cta_label", "label": "Button Label", "default": "Shop Collection →" },
    { "type": "collection", "id": "collection", "label": "Featured Collection" }
  ],
  "presets": [{ "name": "Campaign Kit Banner" }]
}
{% endschema %}
